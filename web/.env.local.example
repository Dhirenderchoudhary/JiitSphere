NEXT_PUBLIC_API_BASE_URL=http://localhost:5050/api/v1
INTERNAL_API_BASE_URL=http://localhost:5050/api/v1
ADMIN_API_KEY=change-this-admin-key
ADMIN_EMAIL=enrollment@mail.jiit.ac.in

# Admin login credentials (SHA-256 hash)
ADMIN_LOGIN_ID=AdminJiit
ADMIN_LOGIN_PASSWORD_HASH=put_sha256_hash_here

# Site-lock password for /study-material access (SHA-256 hash)
STUDY_MATERIAL_PASSWORD_HASH=put_sha256_hash_here

# Optional debug toggles (keep false in production)
NEXT_PUBLIC_SHOW_PORTAL_DIAGNOSTICS=false
NEXT_PUBLIC_SHOW_PORTAL_LOGIN_DIAGNOSTICS=false
NEXT_PUBLIC_SHOW_TECHNICAL_DETAILS=false

# Optional: allow login flow without portal verification (do NOT enable in production)
NEXT_PUBLIC_ALLOW_UNVERIFIED_PORTAL_LOGIN=false
NEXT_PUBLIC_PORTAL_REALTIME=true

# ── Google OAuth (NextAuth) ────────────────────────────────────────
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable Google+ API (or People API)
# 3. OAuth 2.0 Credentials → Web application
# 4. Add authorized redirect URI: https://yourdomain.com/api/auth/callback/google
#    (for local dev: http://localhost:3000/api/auth/callback/google)
# 5. Only @mail.jiit.ac.in accounts are allowed by the app — no config needed.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-strong-random-secret
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
