{
  "name": "jiit-study-material-backend",
  "version": "1.0.0",
  "license": "GPL-3.0-or-later",
  "description": "Backend API for JIITStudyMaterial",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "import:folder": "node src/scripts/importFromFolder.js",
    "import:s3": "node src/scripts/importFromS3.js",
    "normalize:metadata": "node src/scripts/normalizeMetadata.js",
    "normalize:metadata:apply": "node src/scripts/normalizeMetadata.js --apply",
    "lint": "eslint src/ --ext .js",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --runInBand"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1118.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.9.4",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "node-cache": "^5.1.2",
    "pdf-parse": "^2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2"
  }
}
