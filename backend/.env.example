NODE_ENV=development
PORT=5000
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
JSON_BODY_LIMIT_MB=2
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=1200
SERVER_KEEP_ALIVE_TIMEOUT_MS=65000
SERVER_HEADERS_TIMEOUT_MS=66000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=12000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jiit_study_material
ALLOW_START_WITHOUT_DB=false
STORAGE_PROVIDER=local
LOCAL_MATERIALS_ROOT=/Users/nexus/Desktop/j/JIITStudyMaterial/StudyMaterial
PUBLIC_BASE_URL=http://localhost:5000

# Required only when STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=jiit-study-material
CLOUDFRONT_BASE_URL=https://your-cloudfront-domain.cloudfront.net
ADMIN_API_KEY=change-this-admin-key
ADMIN_ALLOWED_EMAILS=9923102082@mail.jiit.ac.in
AUTH_SECRET=replace-with-strong-random-secret
USER_ALLOWED_IDENTIFIERS=9912345678,9923456789,student@mail.jiit.ac.in
# Set USER_ALLOWED_IDENTIFIERS=* to allow all identifiers at app-auth level.
# USER_PASSWORD_HASH must be SHA-256 hash of your shared portal password.
# Example to generate: echo -n "your_password" | shasum -a 256
USER_PASSWORD_HASH=put_sha256_hash_here
PORTAL_RELAY_BASE_URL=https://webportal.jiit.ac.in:6011/studentportal
PORTAL_REALTIME_DEFAULT=true
PORTAL_REALTIME_MIN_SYNC_INTERVAL_MS=15000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=30
RELAY_RATE_LIMIT_WINDOW_MS=60000
RELAY_RATE_LIMIT_MAX=120
MAX_UPLOAD_SIZE_MB=200
PORTAL_REQUEST_TIMEOUT_MS=12000
